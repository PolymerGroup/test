---
import { site } from '../data/site';
const endpoint = site.formEndpoint;
---

{
  endpoint ? (
    <form class="form" data-contact-form action={endpoint} method="POST">
      <label>
        Name
        <input type="text" name="name" required />
      </label>
      <label>
        Email
        <input type="email" name="email" required />
      </label>
      <label>
        Subject
        <input type="text" name="subject" />
      </label>
      <label>
        Message
        <textarea name="message" rows="5" required></textarea>
      </label>

      <button class="btn btn--primary" type="submit">Send message</button>
      <p class="form-success" data-form-success>Thanks — your message has been sent.</p>
      <p class="form-note">
        This form is handled by <a href="https://formspree.io" rel="noopener">Formspree</a> —
        no backend required.
      </p>
    </form>
  ) : (
    <p class="text-muted">
      The contact form is disabled. Set <code>formEndpoint</code> in
      <code> src/data/site.ts</code> (a Formspree endpoint) to enable it, or email us
      directly at <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
    </p>
  )
}

<script>
  const form = document.querySelector('[data-contact-form]');
  const success = document.querySelector('[data-form-success]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (response.ok) {
        form.reset();
        if (success) success.style.display = 'block';
      }
    } catch {
      // Fall back to a normal POST if the AJAX request fails.
      form.submit();
    }
  });
</script>
