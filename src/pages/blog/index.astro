---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../data/site';

const posts = (await Astro.glob('../../content/blog/*.md'))
  .filter((p) => !p.frontmatter.draft)
  .sort(
    (a, b) =>
      new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime(),
  );
---

<BaseLayout title="Blog">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Journal</p>
        <h1>Blog</h1>
        <p class="text-muted">Notes, guides and updates.</p>
      </div>

      <div class="post-list">
        {
          posts.map((post) => (
            <article class="card post-item">
              <time datetime={post.frontmatter.pubDate}>{post.frontmatter.pubDate}</time>
              <h3>
                <a href={withBase(`/blog/${post.frontmatter.slug}/`)}>{post.frontmatter.title}</a>
              </h3>
              <p class="text-muted" style="margin:0;">{post.frontmatter.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
