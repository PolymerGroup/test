---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../data/site';

export async function getStaticPaths() {
  const posts = await Astro.glob('../../content/blog/*.md');
  return posts.map((post) => ({
    params: { slug: post.frontmatter.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = post;
const fm = post.frontmatter;
---

<BaseLayout title={fm.title} description={fm.description}>
  <article class="section">
    <div class="container">
      <p style="margin-bottom:1.5rem;">
        <a href={withBase('/blog/')}>← All posts</a>
      </p>

      <header class="section-head">
        <p class="eyebrow">
          <time datetime={fm.pubDate}>{fm.pubDate}</time>
        </p>
        <h1>{fm.title}</h1>
        {fm.description && <p class="text-muted">{fm.description}</p>}
      </header>

      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
