---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../data/site';
---

<BaseLayout title="Page not found">
  <section class="section text-center">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="text-muted">The page you were looking for doesn't exist or has moved.</p>
      <div class="hero-actions">
        <a class="btn btn--primary" href={withBase('/')}>Go home</a>
        <a class="btn btn--ghost" href={withBase('/products/')}>Browse products</a>
      </div>
    </div>
  </section>
</BaseLayout>
